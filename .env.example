# ============================================
# KOSE CAFE — Konfigurasi Environment Variable
# ============================================
#
# Salin file ini menjadi .env untuk development lokal.
# JANGAN pernah commit file .env ke GitHub!
#
# Untuk PRODUCTION (Vercel):
# Tambahkan DATABASE_URL di dashboard Vercel:
# Settings -> Environment Variables
#
# Contoh format connection string dari Neon.tech:
# postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
#
# Contoh format connection string dari Supabase:
# postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
